#!/data/data/com.termux/files/usr/bin/bash
# proton11-fonts: 安装中文字体到 Wine 前缀
PROJ="${1:-$HOME/proton11}"
PREFIX="${2:-$PROJ/p11prefix}"
FONTS_DIR="$PREFIX/drive_c/windows/Fonts"
REG="$PREFIX/system.reg"

# 判断字体文件是否存在, 不存在则下载
if [ ! -f "$FONTS_DIR/wqy-microhei.ttc" ]; then
  echo "下载文泉驿微米黑..."
  mkdir -p "$FONTS_DIR" "$HOME/tmp"
  curl -sL -o "$HOME/tmp/wqy-microhei.deb" \
    "https://mirrors.kernel.org/ubuntu/pool/universe/f/fonts-wqy-microhei/fonts-wqy-microhei_0.2.0-beta-3.1_all.deb"
  cd "$HOME/tmp" && ar x wqy-microhei.deb && tar xf data.tar.xz
  cp usr/share/fonts/truetype/wqy/wqy-microhei.ttc "$FONTS_DIR/"
  rm -rf "$HOME/tmp/wqy-microhei*" usr
  echo "字体下载完成"
fi

# 注册到注册表 (Windows NT\CurrentVersion\Fonts)
# 先删除旧的 wqy-microhei 条目
sed -i "/wqy-microhei\.ttc/d" "$REG"

# 在 FontSubstitutes 之前插入
LINE=$(grep -n "FontSubstitutes" "$REG" | head -1 | cut -d: -f1)
if [ -n "$LINE" ]; then
  INSERT=$((LINE - 1))
  sed -i "${INSERT}a\\
\"SimSun (TrueType)\"=\"wqy-microhei.ttc\"\\
\"SimSun-ExtB (TrueType)\"=\"wqy-microhei.ttc\"\\
\"Microsoft YaHei (TrueType)\"=\"wqy-microhei.ttc\"\\
\"Microsoft YaHei UI (TrueType)\"=\"wqy-microhei.ttc\"\\
\"Droid Sans Fallback (TrueType)\"=\"wqy-microhei.ttc\"\\
\"Noto Sans CJK SC (TrueType)\"=\"wqy-microhei.ttc\"\\
\"MS Mincho (TrueType)\"=\"wqy-microhei.ttc\"\\
\"MS Gothic (TrueType)\"=\"wqy-microhei.ttc\"\\
\"Yu Gothic (TrueType)\"=\"wqy-microhei.ttc\"\\
\"Meiryo (TrueType)\"=\"wqy-microhei.ttc\"" "$REG"
fi

# 设置 MS Shell Dlg → SimSun (中文回退)
sed -i "s/\"MS Shell Dlg\"=\"Tahoma\"/\"MS Shell Dlg\"=\"SimSun\"/" "$REG"
sed -i "s/\"MS Shell Dlg 2\"=\"Tahoma\"/\"MS Shell Dlg 2\"=\"SimSun\"/" "$REG"

echo "中文字体安装完成: $(ls -lh "$FONTS_DIR/wqy-microhei.ttc" | awk "{print \$5}")"
